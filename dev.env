# Local development env vars. Mirrors what the platform injects in production.
INPUT_DIR=/data/input
OUTPUT_DIR=/data/output
ENVIRONMENT=local
EXECUTION_RUN_ID=local-run-001
INTEGRATION_ID=local-file-conversion-001

# file-conversion specific (all optional)
# OUTPUT_FILENAME=recording.nwb
# CHANNELS=A1,B2
JAVA_CMD=/opt/java/openjdk/bin/java -jar /processor/mefstreamer.jar
